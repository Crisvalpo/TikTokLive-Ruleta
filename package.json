{
  "name": "luke-tiktok-live",
  "version": "1.0.0",
  "description": "TikTok LIVE listener + Interactive 36-segment Roulette Game Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/public', 'dist/public', {recursive: true})\"",
    "start": "node dist/server.js",
    "test:sim": "tsx scripts/test_simulate_event.ts",
    "postinstall": "node -e \"const f='node_modules/tiktok-live-proto/package.json'; if(require('fs').existsSync(f)){const p=JSON.parse(require('fs').readFileSync(f)); p.exports={'./v1':{types:'./dist/node/v1.d.ts',import:'./dist/node/v1.js',require:'./dist/node/v1.js',default:'./dist/node/v1.js'},'./v2':{types:'./dist/node/v2.d.ts',import:'./dist/node/v2.js',require:'./dist/node/v2.js',default:'./dist/node/v2.js'},'./v3':{types:'./dist/node/v3.d.ts',import:'./dist/node/v3.js',require:'./dist/node/v3.js',default:'./dist/node/v3.js'}}; require('fs').writeFileSync(f, JSON.stringify(p, null, 2)); }\""
  },
  "keywords": [
    "tiktok-live",
    "roulette",
    "obs",
    "game-engine",
    "supabase"
  ],
  "author": "LukeAPP",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tiktok-live-connector": "^2.4.3",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
